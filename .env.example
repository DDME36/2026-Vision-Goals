# ─── Required ──────────────────────────────────────────────
# PostgreSQL connection string. With docker-compose this is set for you.
DATABASE_URL=postgres://vision:change-me@localhost:5432/vision_goals

# ─── Optional ──────────────────────────────────────────────
# Public URL of the app (used for metadata / Open Graph).
APP_URL=https://goals.example.com

# Set to "false" to stop new sign-ups once your own account exists.
ALLOW_REGISTRATION=true

# Discord webhook for the anonymous feedback form (hidden when empty).
DISCORD_WEBHOOK_URL=

# Link for the "Crafted by Zentyr" credit in the footer.
NEXT_PUBLIC_BRAND_URL=

# Cookies are Secure in production. Set to "false" only when serving over plain http.
# COOKIE_SECURE=false
